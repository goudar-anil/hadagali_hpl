generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

// Minimal reference to Supabase Auth users.
// Authentication itself is handled by Supabase Auth.
model users {
  id         String      @id @db.Uuid
  admin_user admin_user?

  @@schema("auth")
}

model admin_user {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id   String   @unique @db.Uuid
  role           admin_role @default(ADMIN)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  users          users    @relation(fields: [auth_user_id], references: [id], onUpdate: NoAction)
  audit_log      audit_log[]
  registration_reviews season_player[] @relation("registration_review")
  payment_reviews      season_player[] @relation("payment_review")

  @@schema("public")
}

model audit_log {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_user_id String?     @db.Uuid
  season_id     String?     @db.Uuid
  entity_type   String      @db.VarChar(50)
  entity_id     String      @db.Uuid
  action        String      @db.VarChar(50)
  old_values    Json?
  new_values    Json?
  created_at    DateTime    @default(now()) @db.Timestamptz(6)

  admin_user    admin_user? @relation(fields: [admin_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  season        season?     @relation(fields: [season_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([admin_user_id, created_at(sort: Desc)], map: "audit_log_admin_created_idx")
  @@index([entity_type, entity_id], map: "audit_log_entity_idx")
  @@index([season_id, created_at(sort: Desc)], map: "audit_log_season_created_idx")
  @@schema("public")
}

model season {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String        @db.VarChar(100)
  year                   Int           @db.SmallInt
  status                 season_status @default(DRAFT)
  registration_fee       Decimal       @default(50.00) @db.Decimal(10, 2)
  registration_opens_at  DateTime?     @db.Timestamptz(6)
  registration_closes_at DateTime?     @db.Timestamptz(6)
  auction_purse          Decimal       @db.Decimal(12, 2)
  team_count             Int           @db.SmallInt
  created_at             DateTime      @default(now()) @db.Timestamptz(6)
  updated_at             DateTime      @default(now()) @db.Timestamptz(6)

  audit_log     audit_log[]
  season_player season_player[]
  upload_intent upload_intent[]

  @@index([status])
  @@schema("public")
}

model season_player {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  season_id                String              @db.Uuid
  full_name                String              @db.VarChar(100)
  phone                    String              @db.VarChar(10)
  dob                      DateTime            @db.Date
  playing_role             playing_role
  village                  String              @db.VarChar(100)
  photo_path               String
  payment_proof_path       String
  registration_status      registration_status @default(PENDING_REVIEW)
  payment_status           payment_status      @default(NOT_REVIEWED)
  registration_reviewed_by String?             @db.Uuid
  registration_reviewed_at DateTime?           @db.Timestamptz(6)
  payment_reviewed_by      String?             @db.Uuid
  payment_reviewed_at      DateTime?           @db.Timestamptz(6)
  rejection_reason         String?
  created_at               DateTime            @default(now()) @db.Timestamptz(6)
  updated_at               DateTime            @default(now()) @db.Timestamptz(6)

  registration_reviewer admin_user? @relation("registration_review", fields: [registration_reviewed_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  payment_reviewer      admin_user? @relation("payment_review", fields: [payment_reviewed_by], references: [id], onDelete: Restrict, onUpdate: NoAction)
  season                season      @relation(fields: [season_id], references: [id], onUpdate: NoAction)

  @@unique([season_id, phone], map: "season_player_unique_phone")
  @@index([season_id, created_at(sort: Desc)], map: "season_player_created_at_idx")
  @@index([season_id, full_name], map: "season_player_name_idx")
  @@index([season_id, payment_status], map: "season_player_payment_status_idx")
  @@index([season_id, registration_status], map: "season_player_registration_status_idx")
  @@index([season_id, village], map: "season_player_village_idx")
  @@schema("public")
}

model upload_intent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token_hash  String         @unique
  season_id   String         @db.Uuid
  purpose     upload_purpose
  object_path String         @unique
  expires_at  DateTime       @db.Timestamptz(6)
  consumed_at DateTime?      @db.Timestamptz(6)
  created_at  DateTime       @default(now()) @db.Timestamptz(6)

  season      season         @relation(fields: [season_id], references: [id], onUpdate: NoAction)

  @@index([expires_at], map: "upload_intent_expiry_idx")
  @@schema("public")
}

enum admin_role {
  SUPER_ADMIN
  ADMIN

  @@schema("public")
}

enum payment_status {
  NOT_REVIEWED
  VERIFIED
  REJECTED
  NOT_REQUIRED

  @@schema("public")
}

enum playing_role {
  BATSMAN
  BOWLER
  ALL_ROUNDER
  WICKET_KEEPER

  @@schema("public")
}

enum registration_status {
  PENDING_REVIEW
  APPROVED
  REJECTED

  @@schema("public")
}

enum season_status {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  AUCTION
  IN_PROGRESS
  COMPLETED
  ARCHIVED

  @@schema("public")
}

enum upload_purpose {
  PLAYER_PHOTO
  PAYMENT_PROOF

  @@schema("public")
}